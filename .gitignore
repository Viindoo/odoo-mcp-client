# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node / tooling
node_modules/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.project
.pydevproject

# Local env / secrets
.env
*.local
.claude/settings.local.json
.claude/*.local.json

# Claude Code agent worktrees (per-branch isolated checkouts under .claude/worktrees/) - never
# commit; without this, a fresh clone or CI sees worktree contents in git status --porcelain,
# which make gen-check judges the whole tree by.
.claude/worktrees/

# AI workflow runtime artifacts (project context, BRL jobs, brainstorm state) — never commit (may contain customer data)
.odoo-ai/

# Browser MCP screenshot/video staging (playwright/chrome-devtools output-dir) — transient capture artifacts
.playwright-mcp/
# Doc-capture staging (defense-in-depth: run/module-scoped staging lives under .odoo-ai/visual/ and .playwright-mcp/, but never commit a stray bare doc-staging/ either)
doc-staging/
