#!/usr/bin/env bash
# Confidentiality pre-commit hook for odoo-mcp-client.
#
# Design notes:
#   * Reads the STAGED blob (`git show :"$f"`), never the working-tree file -
#     closes the stage-then-clean bypass vector.
#   * Scans EVERY added/modified text file regardless of extension, including
#     this hook itself and CI workflow files. (A previous version restricted the
#     scan to a fixed extension allowlist, which excluded extensionless files
#     like this hook - letting the guard leak the very terms it was guarding.)
#   * Feeds blob content to grep by HERE-STRING, never by pipe. See scan_blob().
#   * Carries NO sensitive literal in-tree. Project-confidential exact terms live
#     in .githooks/patterns.local (gitignored). The committed file holds only
#     generic structural regexes that name nothing.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Enumerate staged added/modified entries (NUL-delimited, every path - no
# extension filter). Three deliberate choices here, each closing a silent pass:
#
#   --raw, not --name-only: it carries the index MODE beside the path, and the
#   mode is the only honest way to tell an entry that has no blob BY DESIGN from
#   a blob whose read FAILED. Deciding that from the error text would be a guess
#   dressed as a rule.
#
#   --no-renames: git pairs a staged delete+add into ONE `R` record, and
#   --diff-filter=AM drops R - so `git mv secret.md other.md` plus an edit staged
#   a blob the hook never scanned at all. It also stops rename detection reading
#   blob contents merely to enumerate, which otherwise fails the whole
#   enumeration when one object is unreadable.
#
#   a temp file, not a process substitution: `< <(git ...)` DISCARDS git's exit
#   status, so a failed enumeration leaves the list empty and the hook exits 0
#   having scanned NOTHING - the exact silent pass it exists to prevent.
#
# Record shape: ":<srcmode> <dstmode> <srcsha> <dstsha> <status>" NUL "<path>" NUL
RAW_ENTRIES="$(mktemp)"
trap 'rm -f "$RAW_ENTRIES"' EXIT

if ! git diff --cached --raw -z --diff-filter=AM --no-renames >"$RAW_ENTRIES"; then
    echo "ERROR: could NOT enumerate staged entries (see git's message above)." >&2
    echo "       Refusing to report a clean scan on a list that may be incomplete." >&2
    exit 1
fi

SCAN_FILES=()
SCAN_MODES=()
while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
    read -r _srcmode dstmode _rest <<<"${meta#:}"
    SCAN_FILES+=("$path")
    SCAN_MODES+=("$dstmode")
done <"$RAW_ENTRIES"

[ ${#SCAN_FILES[@]} -eq 0 ] && exit 0

# A gitlink (submodule pointer) is an index entry with NO blob to scan: `git show`
# on one succeeds but prints the referenced COMMIT's metadata - author line and
# all - never file content. Skipping it is the correct negative, and it also stops
# the hook scanning a foreign commit's author address as though it were a file
# that exists in this repo.
GITLINK_MODE=160000

staged_content() { git show :"$1" 2>/dev/null; }

# Match one regex against blob content WITHOUT a pipe.
#
# `printf '%s' "$content" | grep -q ...` reads as correct and is a silent-miss
# bug under `set -o pipefail`: grep -q exits at the FIRST match, the writer then
# dies of SIGPIPE (status 141), and pipefail makes that the status of the whole
# pipeline - so an `if` around it sees FALSE. Above the ~64KB pipe buffer a MATCH
# therefore becomes indistinguishable from a NON-MATCH and the rule never fires,
# silently, on exactly the large files most likely to carry something. A
# here-string removes the writer process, so grep's own status is the only
# status, at every blob size.
#
# Exit: 0 = match, 1 = no match, >=2 = grep itself failed (bad regex, read error).
scan_blob() {  # $1 = extended regex, $2 = blob content
    grep -qIE -e "$1" <<<"$2"
}

# Apply one positive rule to one blob and report it.
# A grep ERROR is escalated exactly like a match: a scanner that cannot scan
# must never be mistaken for a clean pass.
check_rule() {  # $1 = regex, $2 = content, $3 = path, $4 = message
    local rc=0
    scan_blob "$1" "$2" || rc=$?
    case "$rc" in
        0) echo "ERROR: $4: $3" >&2
           HARD_FAIL=1 ;;
        1) ;;
        *) echo "ERROR: scan FAILED (grep status $rc) applying /$1/ to staged blob: $3" >&2
           HARD_FAIL=1 ;;
    esac
}

# --- Generic structural config (always on; reference nothing sensitive) -------
# Placeholder usernames that are legitimate documentation, not real paths.
ALLOW_USER='(user|username|youruser|USER|me|example)'

# --- Project-confidential exact terms loaded from an untracked file ----------
# Format: one extended-regex per line; '#' comments and blank lines ignored.
#
# Resolution order is load-bearing. patterns.local is gitignored, so it exists
# only in the PRIMARY checkout - but branch work happens in LINKED WORKTREES,
# where $REPO_ROOT is the worktree root and the file is simply absent. Resolving
# from $REPO_ROOT alone therefore downgraded the hook to structural-checks-only
# exactly where the commits are made, and still exited 0.
# `git rev-parse --git-common-dir` names the SHARED git dir (the primary
# checkout's .git, even when invoked from a worktree), so its parent is the
# primary checkout root. $REPO_ROOT stays as a fallback so a plain clone - where
# the two are the same path - behaves exactly as before.
GIT_COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || true)"
# May be relative (a bare `.git` in the primary checkout); we are already cd'd
# to $REPO_ROOT, so anchor a relative answer there rather than at $PWD-by-luck.
case "$GIT_COMMON_DIR" in
    '')  ;;
    /*)  ;;
    *)   GIT_COMMON_DIR="${REPO_ROOT}/${GIT_COMMON_DIR}" ;;
esac
PRIMARY_ROOT=""
if [ -n "$GIT_COMMON_DIR" ]; then
    PRIMARY_ROOT="$(cd "$(dirname "$GIT_COMMON_DIR")" 2>/dev/null && pwd -P)" || PRIMARY_ROOT=""
fi

PATTERNS_CANDIDATES=()
if [ -n "$PRIMARY_ROOT" ]; then
    PATTERNS_CANDIDATES+=("${PRIMARY_ROOT}/.githooks/patterns.local")
fi
if [ "$PRIMARY_ROOT" != "$REPO_ROOT" ]; then
    PATTERNS_CANDIDATES+=("${REPO_ROOT}/.githooks/patterns.local")
fi

LOCAL_PATTERNS_FILE=""
for candidate in "${PATTERNS_CANDIDATES[@]}"; do
    if [ -f "$candidate" ]; then
        LOCAL_PATTERNS_FILE="$candidate"
        break
    fi
done

declare -a LOCAL_PATTERNS=()
if [ -n "$LOCAL_PATTERNS_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|\#*) continue ;; esac
        LOCAL_PATTERNS+=("$line")
    done < "$LOCAL_PATTERNS_FILE"
else
    echo "note: .githooks/patterns.local not found - running structural checks only." >&2
    for candidate in "${PATTERNS_CANDIDATES[@]}"; do
        echo "      looked in: $candidate" >&2
    done
    echo "      Copy .githooks/patterns.local.example to .githooks/patterns.local in the" >&2
    echo "      PRIMARY checkout (not a worktree) and fill in real terms." >&2
fi

HARD_FAIL=0

for i in "${!SCAN_FILES[@]}"; do
    f="${SCAN_FILES[$i]}"
    mode="${SCAN_MODES[$i]}"

    # THREE outcomes, never two - the same distinction scan_blob() makes:
    #   no blob BY DESIGN (gitlink) -> a real negative, skip it quietly
    #   blob reads OK               -> scan it
    #   read FAILS for any other reason -> BLOCK, exactly like a match
    # A file that could not be scanned must never be indistinguishable from a
    # file that scanned clean, which is what `|| continue` used to make it.
    [ "$mode" = "$GITLINK_MODE" ] && continue

    rc=0
    content="$(staged_content "$f")" || rc=$?
    if [ "$rc" -ne 0 ]; then
        # Re-read only on the failure path, to surface git's own diagnosis.
        reason="$(git show ":$f" 2>&1 >/dev/null || true)"
        echo "ERROR: could NOT read staged blob (mode $mode, git status $rc) - refusing to treat it as clean: $f${reason:+ - ${reason//$'\n'/ }}" >&2
        HARD_FAIL=1
        continue
    fi

    # Personal gmail address (a public repo should use a noreply/company address).
    check_rule '[A-Za-z0-9._%+-]+@gmail\.com' "$content" "$f" \
        "personal gmail address in staged blob"

    # Absolute /home/<user>/ or /Users/<user>/ path (non-portable), excluding
    # generic placeholder usernames used in documentation examples. Two stages,
    # so it cannot use check_rule: collect the candidate lines, then look for one
    # the placeholder allowlist does NOT excuse.
    rc=0
    abs_paths="$(grep -IE -e '/(home|Users)/[A-Za-z0-9._-]+/' <<<"$content")" || rc=$?
    if [ "$rc" -gt 1 ]; then
        echo "ERROR: scan FAILED (grep status $rc) applying the absolute-path rule to staged blob: $f" >&2
        HARD_FAIL=1
    elif [ -n "$abs_paths" ]; then
        # The -n guard is load-bearing: on no candidates the here-string would
        # still feed grep one EMPTY line, which `grep -v` matches, firing the
        # rule on every clean file.
        rc=0
        grep -qvE -e "/(home|Users)/${ALLOW_USER}/" <<<"$abs_paths" || rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "ERROR: absolute /home|/Users/<user>/ path (non-portable) in staged blob: $f" >&2
            HARD_FAIL=1
        elif [ "$rc" -gt 1 ]; then
            echo "ERROR: scan FAILED (grep status $rc) applying the absolute-path rule to staged blob: $f" >&2
            HARD_FAIL=1
        fi
    fi

    # Relative "personal vault" folder convention - a PARA-style private notes vault path
    # hardcoded into agent prose (top-level folder like Resources or Sales, then a named
    # sub-folder such as Competitors or Customers, then a file). Never a repo-relative path.
    # The caller's own vault layout belongs behind an optional env-rooted read (see
    # snippets/disk-fallback-protocol.md's `$ODOO_AI_VAULT_HOME`), not a hardcoded literal.
    # (NOTE: do not spell out the literal pattern here as contiguous text - it would trip
    # this very check on this file. Keep this comment worded like the paragraph above.)
    check_rule '(Resources|Sales)/(Competitors|Customers)' "$content" "$f" \
        "hardcoded vault-folder convention in staged blob"

    # Guard the expansion: on bash < 4.4 an empty array under `set -u` is an
    # "unbound variable" error, which would hard-fail the commit of a
    # contributor who legitimately has no patterns.local. Iterating an empty
    # array runs zero times on every bash, so the guard changes no behaviour.
    if [ "${#LOCAL_PATTERNS[@]}" -gt 0 ]; then
        for regex in "${LOCAL_PATTERNS[@]}"; do
            check_rule "$regex" "$content" "$f" "confidential term /${regex}/ in staged blob"
        done
    fi
done

[ "$HARD_FAIL" -eq 1 ] && {
    echo "Commit blocked by confidentiality pre-commit hook." >&2
    exit 1
}

# Soft warning: possible sensitive numbers (money / OKR percentages).
# Same here-string discipline as the hard rules above - a piped `grep -q` would
# go quiet on large blobs.
for i in "${!SCAN_FILES[@]}"; do
    f="${SCAN_FILES[$i]}"
    [ "${SCAN_MODES[$i]}" = "$GITLINK_MODE" ] && continue
    # Any genuine read failure already blocked above, so a miss here cannot be silent.
    content="$(staged_content "$f")" || continue
    rc=0
    scan_blob '(\$[0-9]{4,}|[0-9]{1,3}([,.][0-9]{3}){2,}[[:space:]]*(VND|USD)|OKR.*[0-9]{2}%)' \
        "$content" || rc=$?
    if [ "$rc" -eq 0 ]; then
        echo "WARNING: possible sensitive number in staged blob - review before pushing: $f" >&2
    elif [ "$rc" -gt 1 ]; then
        echo "WARNING: scan FAILED (grep status $rc) applying the sensitive-number rule to: $f" >&2
    fi
done

exit 0
